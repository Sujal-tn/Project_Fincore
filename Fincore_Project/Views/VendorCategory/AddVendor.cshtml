@model List<Vendor>

<a id="btn" class="btn btn-primary">Add Vendor</a>


<table class="table">
    <thead>
        <tr>
            <th scope="col">ID</th>
            <th scope="col">Vendor Code</th>
            <th scope="col">Vendor Category</th>
            <th scope="col">Company</th>
            <th scope="col"> Bank Account Number</th>         
            <th scope="col">PAN Number</th>
            <th scope="col">Status</th>
            <th scope="col">Action</th>
        </tr>
    </thead>
    <tbody>
@foreach (var d in Model)
{
    <tr>
        <td>@d.VendorId</td>
        <td>@d.VendorCode</td>
        <td>@d.VendorCategory?.CategoryName</td>
        <td>@d.Company?.CompanyName</td>
        <td>@d.BankAccount</td>
        <td>@d.PAN</td>
        <td>
            @(d.IsActive == 1 ? "Active" : "Inactive")
        </td>
        <td>
             <button type="button"
            class="btn btn-sm btn-warning editBtn"
            data-id="@d.VendorId">
             Edit
             </button>

            <a asp-action="DeleteVendor"
               asp-route-id="@d.VendorId"
               onclick="return confirm('Are you sure?')"
               class="btn btn-sm btn-danger">Delete</a>
        </td>
    </tr>
}
</tbody>
</table>


<div class="modal fade" id="exampleModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Modal title</h5>

                <button type="button"
                        class="close"
                        data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>

            <div class="modal-body">

                <form id="vendorform" method="post">

                    <input type="hidden" id="VendorId" name="VendorId" />

                    Vendor Code
                    <input type="text"
                           name="VendorCode"
                           class="form-control"/>

                     Vendor Category
                    <select name="VendorCategoryId"
                            asp-items="ViewBag.Category"
                            class="form-control">
                        <option value="">-- Select  Vendor Category --</option>
                    </select>

                     Company
                    <select name="CompanyId"
                            asp-items="ViewBag.Company"
                            class="form-control">
                        <option value="">-- Select Company --</option>
                    </select>


                    Bank Account Number
                    <input type="text"
                           name="BankAccount"
                           class="form-control" />

                    PAN Number
                     <input type="text"
                           name="PAN"
                           class="form-control" />



                    Status
                    <select class="form-control"
                            name="IsActive">
                        <option value="1">Active</option>
                        <option value="0">InActive</option>

                    </select>

                    <input type="submit"
                           value="Save"
                           id="savebtn"
                           class="btn btn-primary" />

                </form>

            </div>

            <div class="modal-footer">

                

                <button type="button"
                        class="btn btn-secondary"
                        data-dismiss="modal"
                        id="closemodal">
                    Close
                </button>

            </div>

        </div>
    </div>
</div>



<script src="~/lib/jquery/dist/jquery.js"></script>
@* <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script> *@
<script src="~/js/javascript.js"></script>
